      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True/PM_V2"/>
        <TextName Value="NovaMonitor.Application"/>
        <TextDesc Value="NovaMonitor Telemetry Dashboard"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages Count="2">
      <Item1>
        <PackageName Value="LCL"/>
      </Item1>
      <Item2>
        <PackageName Value="fcl-json"/>
      </Item2>
    </RequiredPackages>
    <Units Count="7">
      <Unit0>
        <Filename Value="NovaMonitor.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="src\Common\Nova.Types.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit1>
      <Unit2>
        <Filename Value="src\Common\Nova.Utils.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit2>
      <Unit3>
